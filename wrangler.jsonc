{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shastainspections",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",

  "observability": {
    "enabled": true
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Serves /bio from public/bio.html and redirects /bio.html -> /bio.
    "html_handling": "auto-trailing-slash",
    // Unmatched paths get public/404.html with a 404 status.
    "not_found_handling": "404-page",
    // Without this, not_found_handling would swallow /api/* before the
    // Worker ever ran. Scoped so static pages still bypass the Worker.
    "run_worker_first": ["/api/*"]
  },

  // Cloudflare Email Sending. The `from` domain must be onboarded first:
  //   npx wrangler email sending enable shastainspections.com
  "send_email": [
    { "name": "EMAIL" }
  ],

  "vars": {
    "CONTACT_TO": "riley@shastainspections.com",
    "CONTACT_FROM": "website@shastainspections.com"
  },

  "routes": [
    { "pattern": "shastainspections.com", "custom_domain": true },
    { "pattern": "www.shastainspections.com", "custom_domain": true }
  ]
}
